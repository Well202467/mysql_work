<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.smartlearning.mapper.CourseMapper">

    <select id="selectKnowledgePointsByCourseId" resultType="com.example.smartlearning.entity.KnowledgePoint">
        SELECT
            id,
            course_id,
            name,
            description,
            difficulty,
            ability,
            source
        FROM knowledge_point
        WHERE course_id = #{courseId}
        ORDER BY id
    </select>
</mapper>
